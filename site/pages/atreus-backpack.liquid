---
layout: layout.liquid
title: Atreus Backpack
permalink: /products/atreus-backpack/
bodyClass: template-product
---
<section class="pdp" data-section="pdp" data-section-theme="light">
  {%- comment -%}
    Gallery is a vertical stack of media items. On desktop each fills the
    viewport and scrolls past the sticky info column; on mobile the first is
    the main image and the rest become the tappable thumbnail strip.
  {%- endcomment -%}
  {%- assign media = "product-atreus-black-main@2x.png|thumb-atreus-black-main.png|Atreus Black Backpack,product-atreus-black-lock@2x.png|thumb-atreus-black-lock.png|Atreus buckle detail,product-atreus-inside@2x.png|thumb-atreus-inside.png|Atreus interior compartments,product-atreus-black-laptop-strap@2x.png|thumb-atreus-black-laptop-strap.png|Atreus laptop retention strap" | split: "," -%}
  <div class="pdp__gallery" data-gallery data-media-count="{{ media | size }}">
    <div class="pdp__media">
      {%- for m in media -%}
        {%- assign parts = m | split: "|" -%}
        {%- assign src = parts[0] -%}
        {%- unless src contains "." -%}{%- assign src = src | append: ".png" -%}{%- endunless -%}
        <div class="pdp__media-item{% if forloop.first %} is-main{% endif %}"{% if forloop.first %} data-gallery-main{% endif %}>
          <img src="/assets/images/{{ src }}" alt="{{ parts[2] }}"{% unless forloop.first %} loading="lazy"{% endunless %}>
        </div>
      {%- endfor -%}
      <div class="pdp__dots" data-gallery-dots aria-hidden="true">
        {%- for m in media -%}
          <span class="pdp__dot{% if forloop.first %} is-active{% endif %}"></span>
        {%- endfor -%}
      </div>
    </div>
    <div class="pdp__thumbs" data-gallery-thumbs>
      {%- for m in media -%}
        {%- assign parts = m | split: "|" -%}
        {%- assign thumb_src = parts[1] -%}
        <button class="pdp__thumb{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="View {{ parts[2] }}"><img src="/assets/images/{{ thumb_src }}" alt="{{ parts[2] }}" loading="lazy"></button>
      {%- endfor -%}
    </div>
  </div>

  <div class="pdp__info">
    <h1 class="pdp__title">Atreus Backpack</h1>
    <p class="pdp__price">{{ 3990 | money }}</p>
    <div class="pdp__color">
      <p>Color: <strong data-color-label>Black</strong></p>
      <div class="pdp__swatches" role="radiogroup" aria-label="Colour">
        <button class="swatch swatch--black is-active" aria-label="Black" role="radio" aria-checked="true"></button>
        <button class="swatch swatch--grey" aria-label="Grey" role="radio" aria-checked="false"></button>
        <button class="swatch swatch--bronze" aria-label="Bronze" role="radio" aria-checked="false"></button>
      </div>
    </div>
    <div class="pdp__buy">
      <div class="qty" data-qty>
        <button class="qty__btn" data-qty-minus aria-label="Decrease quantity">{% render "snippets/icon", name: "minus" %}</button>
        <span class="qty__value" data-qty-value>1</span>
        <button class="qty__btn" data-qty-plus aria-label="Increase quantity">{% render "snippets/icon", name: "plus" %}</button>
      </div>
      {%- comment -%} Explicit markup rather than the button snippet so it can carry
        the data hooks the cart engine reads. {%- endcomment -%}
      <button type="button" class="btn btn--dark pdp__add" data-add data-product-handle="atreus-black-backpack">
        <span class="btn__label">Add to bag</span>
        <span class="btn__icon">{% render "snippets/icon", name: "arrow-up-right" %}</span>
      </button>
    </div>
    <p class="pdp__blurb">Water-repellent nylon shell. Rain lands, rain rolls off. The top flap secures with dual buckle locks to shield your main items, while a coated waterproof zipper underneath keeps your lower pocket completely dry.</p>

    <div class="pdp__accordions">
      <details class="accordion">
        <summary>Details &amp; Specifications {% render "snippets/icon", name: "plus" %}</summary>
        <div class="accordion__body">
          <p>Water-repellent nylon shell. Padded 15" laptop sleeve. Quick-access front pocket. Reinforced base. 20L capacity.</p>
        </div>
      </details>
      <details class="accordion">
        <summary>Shipping, Returns &amp; Warranty {% render "snippets/icon", name: "plus" %}</summary>
        <div class="accordion__body">
          <p>Free shipping over ₱2,500. 30-day returns. 2-year warranty against manufacturing defects.</p>
        </div>
      </details>
    </div>
  </div>
</section>

{%- comment -%} A product never appears in its own recommendations. {%- endcomment -%}
{% render "sections/product-grid", heading: "You might also like", products: products, hide_link: true, exclude: "atreus-black-backpack", anchor: "related" %}
