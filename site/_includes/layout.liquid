<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} — {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ site.tagline }}">
  <link rel="preload" href="/assets/fonts/open-sauce-two-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/open-sauce-two-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/fonts.css">
  <link rel="stylesheet" href="/assets/css/tokens.css">
  <link rel="stylesheet" href="/assets/css/theme.css">
</head>
<body class="{{ bodyClass | default: '' }}">
  <div class="page-intro" data-page-intro aria-hidden="true">
    <div class="page-intro__logo">{% render "snippets/logo" %}</div>
  </div>
  {% render "sections/header", site: site %}
  <main id="main">
    {{ content }}
  </main>
  {% render "sections/footer", site: site %}

  <script src="https://cdn.jsdelivr.net/npm/lenis@1.1.18/dist/lenis.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" defer></script>
  <script src="/assets/js/theme.js" defer></script>
</body>
</html>
