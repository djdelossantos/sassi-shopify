<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SASSi Rabbit{% if title %} - {{ title }}{% endif %}</title>
  <meta name="description" content="{{ site.tagline }}">
  <link rel="preload" href="/assets/fonts/open-sauce-two-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/open-sauce-two-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/fonts.css">
  <link rel="stylesheet" href="/assets/css/tokens.css">
  <link rel="stylesheet" href="/assets/css/theme.css">
  {%- comment -%} First-load preloader must paint dark on the very first frame. {%- endcomment -%}
  <style>.preloader{position:fixed;inset:0;z-index:10000;background:#12100e;display:flex;align-items:center;justify-content:center}</style>
  <noscript><style>.preloader{display:none!important}</style></noscript>
</head>
<body class="{{ bodyClass | default: '' }}">
  <div class="preloader" data-preloader aria-hidden="true">
    <div class="preloader__inner">
      <span class="preloader__count" data-preloader-count>00</span>
      <div class="preloader__dots"><span></span><span></span><span></span></div>
    </div>
  </div>
  <div class="page-intro" data-page-intro aria-hidden="true">
    <div class="page-intro__logo">{% render "snippets/logo" %}</div>
  </div>
  {% render "sections/header", site: site %}
  <main id="main">
    {{ content }}
  </main>
  {% render "sections/footer", site: site %}
  {% render "snippets/cart-drawer" %}

  {%- comment -%} Catalogue for the client-side cart, search and filters — the
    Shopify theme gets this from Liquid/AJAX; here it is inlined once. {%- endcomment -%}
  <script type="application/json" data-products>{{ products | json }}</script>

  <script src="https://cdn.jsdelivr.net/npm/lenis@1.1.18/dist/lenis.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" defer></script>
  <script src="/assets/js/theme.js" defer></script>
</body>
</html>
