<section class="black-series" data-section="black-series" data-section-theme="light">
  <img class="black-series__bg" src="/assets/images/black-series-bg@2x.webp" alt="" aria-hidden="true" loading="lazy">
  <div class="black-series__bags">
    <img class="black-series__bag black-series__bag--athena" src="/assets/images/black-series-athena@2x.png" alt="SASSi Athena handbag" loading="lazy">
    <img class="black-series__bag black-series__bag--artemis" src="/assets/images/black-series-artemis@2x.png" alt="SASSi Artemis tote" loading="lazy">
    <img class="black-series__bag black-series__bag--atlas" src="/assets/images/black-series-atlas@2x.png" alt="SASSi Atlas backpack" loading="lazy">
    <img class="black-series__bag black-series__bag--apollo" src="/assets/images/black-series-apollo@2x.png" alt="SASSi Apollo utility tote" loading="lazy">
  </div>
  <div class="black-series__head">
    <h2 class="black-series__heading reveal">Black Series</h2>
    <p class="black-series__sub reveal">Blacked out. Built up.</p>
  </div>
  <div class="black-series__cta reveal">
    {% render "snippets/button", label: "Learn More", style: "dark", href: "/#new-arrivals" %}
  </div>
</section>
