<section class="brand-intro" id="brand" data-section="brand-intro" data-section-theme="light">
  <div class="brand-intro__media reveal" data-section-theme="dark">
    <img src="/assets/images/brand-intro@2x.png" alt="SASSi strap detail" loading="lazy">
  </div>
  <div class="brand-intro__copy">
    <div class="brand-intro__inner">
      <h2 class="brand-intro__heading reveal">A reliable product for the&nbsp;people <span class="text-brand">we rely on.</span></h2>
      <p class="brand-intro__body reveal">Bags for the shift, the commute, and everything you haul in between. No fuss, no flex, gear that shows up every day, the way you do.</p>
      <div class="brand-intro__cta reveal">
        {% render "snippets/button", label: "Learn More", style: "dark", href: "/#new-arrivals" %}
      </div>
    </div>
  </div>
</section>
