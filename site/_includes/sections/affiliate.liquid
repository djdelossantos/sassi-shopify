  <div class="affiliate__inner">
    <div class="affiliate__copy">
      <p class="affiliate__eyebrow">
        <span class="affiliate__rule" aria-hidden="true"></span>
        <span class="affiliate__eyebrow-label">Affiliate Program</span>
      </p>
      <h2 class="affiliate__heading">Love SASSi?<br>Get paid to <span class="text-brand">share&nbsp;it.</span></h2>
