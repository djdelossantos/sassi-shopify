<header class="site-header" data-header>
  <div class="site-header__inner">
    <div class="site-header__left">
      <button class="site-header__burger" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="site-header__burger-open">{% render "snippets/icon", name: "menu" %}</span>
        <span class="site-header__burger-close">{% render "snippets/icon", name: "close" %}</span>
      </button>
      <nav class="site-header__nav" aria-label="Main">
        <a href="/shop/">Shop</a>
        <a href="/about-us/">The Brand</a>
      </nav>
    </div>
    <a class="site-header__logo" href="/" aria-label="SASSi home">
      <span class="site-header__logo-mark" role="img" aria-label="SASSi"></span>
    </a>
    <div class="site-header__icons">
      {%- comment -%} Stays a real link so it works without JS; theme.js intercepts
        the click and expands the header panel instead. {%- endcomment -%}
      <a href="/search/" aria-label="Search" data-search-toggle aria-expanded="false" aria-controls="header-search">{% render "snippets/icon", name: "search" %}</a>
      <a href="#" aria-label="Account" class="site-header__account">{% render "snippets/icon", name: "account" %}</a>
      <a class="site-header__bag" href="#" aria-label="Bag (0)" data-cart-count>
        {% render "snippets/icon", name: "bag" %}
        <span class="site-header__bag-count" data-cart-count-value hidden>0</span>
      </a>
    </div>
  </div>

  {%- comment -%} Expanding search panel — collapsed to zero height until the
    search icon is clicked (see initHeaderSearch). {%- endcomment -%}
  <div class="site-header__search" id="header-search">
    <div class="site-header__search-inner">
      <form action="/search/" method="get" role="search">
        <input class="site-header__search-input" type="search" name="q"
               placeholder="Search products" aria-label="Search products"
               autocomplete="off" data-search-input>
        <button type="submit" class="visually-hidden">Search</button>
      </form>
    </div>
  </div>
  <nav class="site-header__drawer" id="mobile-menu" aria-label="Mobile">
    <a href="/shop/">Shop</a>
    <a href="/about-us/">The Brand</a>
    <a href="#">Account</a>
    <p class="site-header__drawer-copyright">{{ site.copyright }}</p>
  </nav>
</header>
