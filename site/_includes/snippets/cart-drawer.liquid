{%- comment -%}
  Slide-in cart drawer. Rendered once in the layout so it persists on every page.

  Prototype note: the Shopify theme re-fetches this section from the server after
  every cart mutation. Here there is no server, so theme.js owns a cart in
  localStorage and renders the line items into [data-cart-items] client-side.
  The shell, empty state and footer below are the design source of truth.
{%- endcomment -%}
<div class="cart-drawer" data-cart-drawer hidden>
  <div class="cart-drawer__scrim" data-cart-close></div>
  <aside class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="Your cart" data-cart-panel>
    <header class="cart-drawer__head">
      <h2 class="cart-drawer__title">
        Your cart <span class="cart-drawer__count" data-cart-title-count>(0 items)</span>
      </h2>
      <button type="button" class="cart-drawer__close" data-cart-close aria-label="Close cart">
        {% render "snippets/icon", name: "close" %}
      </button>
    </header>

    <ul class="cart-drawer__items" data-cart-items hidden></ul>

    <footer class="cart-drawer__foot" data-cart-foot hidden>
      <div class="cart-drawer__total">
        <span>Total</span>
        <strong data-cart-total>₱0.00</strong>
      </div>
      <p class="cart-drawer__tax">Taxes calculated at checkout</p>
      <a class="btn btn--light cart-drawer__checkout" href="#">
        <span class="btn__label">Checkout</span>
        <span class="btn__icon">{% render "snippets/icon", name: "arrow-up-right" %}</span>
      </a>
    </footer>

    <div class="cart-drawer__empty" data-cart-empty>
      <p>Your cart is empty</p>
      <a class="btn btn--light" href="/shop/">
        <span class="btn__label">Continue shopping</span>
        <span class="btn__icon">{% render "snippets/icon", name: "arrow-up-right" %}</span>
      </a>
    </div>
  </aside>
</div>
