{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  # Static fallback for the back link — used when there's no real in-app
  # history to return to (see initPdpBack in theme.js, which prefers
  # history.back() and only falls back to this href otherwise).
  assign back_url = '/collections/all'
  if collection != blank
    assign back_url = collection.url
  elsif product.collections.first != blank
    assign back_url = product.collections.first.url
  endif
-%}
<section class="pdp" data-section="pdp" data-section-theme="light">
  {%- comment -%}
    Colour filtering: each photo belongs to one colour or to all of them.
    - Alt text naming a colour ("Black", or "Black - side view": only the part
      before " - " or " | " counts) ties the photo to that colour.
    - Otherwise a photo set as a colour's variant image belongs to that colour.
    - Anything else is shared and shows for every colour.
    Only the selected colour's photos (plus shared ones) render visible; theme.js
    (initGallery → pdpGallery.filter) re-filters when another swatch is picked.
    If a colour has no photos of its own, everything shows rather than nothing.
  {%- endcomment -%}
  {%- liquid
    assign color_index = -1
    for option in product.options_with_values
      assign opt_name = option.name | downcase
      if opt_name contains 'color' or opt_name contains 'colour'
        assign color_index = forloop.index0
        assign color_values = ''
        for value in option.values
          assign vname = value.name | default: value | strip | downcase
          assign color_values = color_values | append: '|' | append: vname
        endfor
        assign color_values = color_values | append: '|'
        break
      endif
    endfor

    assign media_colors = ''
    assign selected_color = ''
    if color_index >= 0
      assign selected_color = current_variant.options[color_index] | strip | downcase
      for media in product.media
        assign tag = media.alt | split: ' - ' | first | split: ' | ' | first | strip | downcase
        assign needle = '|' | append: tag | append: '|'
        assign mcolor = ''
        if tag != blank and color_values contains needle
          assign mcolor = tag
        else
          for v in product.variants
            if v.featured_media.id == media.id
              assign mcolor = v.options[color_index] | strip | downcase
              break
            endif
          endfor
        endif
        assign media_colors = media_colors | append: mcolor | append: '|'
      endfor
    endif
    assign media_colors = media_colors | split: '|'

    assign own_count = 0
    for media in product.media
      if media_colors[forloop.index0] == selected_color and selected_color != blank
        assign own_count = own_count | plus: 1
      endif
    endfor
    if own_count == 0
      assign selected_color = ''
    endif

    assign visible_count = 0
    assign first_visible = -1
    for media in product.media
      assign mc = media_colors[forloop.index0]
      if selected_color == blank or mc == blank or mc == selected_color
        assign visible_count = visible_count | plus: 1
        if first_visible < 0
          assign first_visible = forloop.index0
        endif
      endif
    endfor
  -%}
  {%- comment -%} Gallery: desktop stacks the visible media past the sticky info; mobile
    shows one at a time + a tappable thumbnail strip (see theme.js initGallery). {%- endcomment -%}
  <div class="pdp__gallery" data-gallery data-media-count="{{ product.media.size }}">
    <div class="pdp__media" data-gallery-stage>
      {%- for media in product.media -%}
        {%- liquid
          assign mc = media_colors[forloop.index0]
          assign shown = false
          if selected_color == blank or mc == blank or mc == selected_color
            assign shown = true
          endif
          # Empty alt text comes back as the product title, so skip that case.
          if media.alt != blank and media.alt != product.title
            assign img_alt = product.title | append: ' — ' | append: media.alt
          else
            assign img_alt = product.title
          endif
        -%}
        <div class="pdp__media-item{% if forloop.index0 == first_visible %} is-main{% endif %}{% unless shown %} is-filtered-out{% endunless %}" data-media-color="{{ mc | escape }}">
          <img src="{{ media | image_url: width: 1400 }}" alt="{{ img_alt | escape }}"{% unless forloop.index0 == first_visible %} loading="lazy"{% endunless %}>
        </div>
      {%- else -%}
        <div class="pdp__media-item is-main">{{ 'product-1' | placeholder_svg_tag: 'pdp__placeholder' }}</div>
      {%- endfor -%}
      {%- if product.media.size > 1 -%}
        <div class="pdp__dots{% if visible_count < 2 %} is-filtered-out{% endif %}" data-gallery-dots aria-hidden="true">
          {%- for media in product.media -%}
            {%- assign mc = media_colors[forloop.index0] -%}
            <span class="pdp__dot{% if forloop.index0 == first_visible %} is-active{% endif %}{% unless selected_color == blank or mc == blank or mc == selected_color %} is-filtered-out{% endunless %}"></span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    {%- if product.media.size > 1 -%}
      <div class="pdp__thumbs{% if visible_count < 2 %} is-filtered-out{% endif %}" data-gallery-thumbs>
        {%- for media in product.media -%}
          {%- assign mc = media_colors[forloop.index0] -%}
          <button class="pdp__thumb{% if forloop.index0 == first_visible %} is-active{% endif %}{% unless selected_color == blank or mc == blank or mc == selected_color %} is-filtered-out{% endunless %}" aria-label="View image {{ forloop.index }}"><img src="{{ media | image_url: width: 200 }}" alt="" loading="lazy"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} data-lenis-prevent is applied by theme.js (initPdpScroll), not here —
    it only belongs on this column while the content actually overflows. {%- endcomment -%}
  <div class="pdp__info">
    {%- comment -%} Returns to wherever the customer actually came from (category,
      search, etc.) via history.back() when there's real in-app history to go to;
      falls back to this href — the product's collection, or Shop All — otherwise.
      Kept outside .pdp__info-content so it doesn't get swept into that column's
      vertical-centering (see the desktop .pdp__info-content rules). {%- endcomment -%}
    <a href="{{ back_url }}" class="pdp__back" data-pdp-back>
      {% render 'icon', name: 'arrow-left' %}
      <span>Back</span>
    </a>
    <div class="pdp__info-content">
    <h1 class="pdp__title">{{ product.title }}</h1>
    <p class="pdp__price" data-price>{{ current_variant.price | money }}</p>

    {%- comment -%} Option controls live OUTSIDE the form; JS reads them and sets the
      hidden variant id inside the form (keeps the design's layout intact). {%- endcomment -%}
    {%- unless product.has_only_default_variant -%}
      {%- for option in product.options_with_values -%}
        {%- liquid
          assign opt_name = option.name | downcase
          assign is_color = false
          if opt_name contains 'color' or opt_name contains 'colour'
            assign is_color = true
          endif
        -%}
        <div class="pdp__color" data-option-index="{{ forloop.index0 }}">
          {%- if is_color -%}
            <p>{{ option.name }}: <strong data-color-label>{{ option.selected_value }}</strong></p>
            <div class="pdp__swatches" role="radiogroup" aria-label="{{ option.name | escape }}">
              {%- for value in option.values -%}
                {%- capture sw_style -%}{% render 'swatch-style', value: value %}{%- endcapture -%}
                {%- liquid
                  # value is an object on newer Shopify (with a native .swatch), a plain string on older
                  assign vname = value.name | default: value
                  assign is_sel = false
                  if option.selected_value == vname
                    assign is_sel = true
                  endif
                -%}
                <button type="button" class="swatch{% if is_sel %} is-active{% endif %}" data-value="{{ vname | escape }}" style="{{ sw_style | strip }}" role="radio" aria-checked="{{ is_sel }}" aria-label="{{ vname | escape }}"></button>
              {%- endfor -%}
            </div>
          {%- else -%}
            <p class="pdp__option-label">{{ option.name }}</p>
            <select class="pdp__option-select" data-option-select aria-label="{{ option.name | escape }}">
              {%- for value in option.values -%}
                <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
              {%- endfor -%}
            </select>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- endunless -%}

    {%- if settings.marketplace_mode -%}
      {% render 'marketplace-buy', product: product %}
    {%- else -%}
    {%- form 'product', product, class: 'pdp__form' -%}
      <div class="pdp__buy">
        <div class="qty" data-qty>
          <button type="button" class="qty__btn" data-qty-minus aria-label="Decrease quantity">{% render 'icon', name: 'minus' %}</button>
          <span class="qty__value" data-qty-value>1</span>
          <button type="button" class="qty__btn" data-qty-plus aria-label="Increase quantity">{% render 'icon', name: 'plus' %}</button>
        </div>
        <input type="hidden" name="quantity" value="1" data-qty-input>
        <input type="hidden" name="id" value="{{ current_variant.id }}">
        <button type="submit" name="add" class="btn btn--dark pdp__add" data-add {% unless current_variant.available %}disabled{% endunless %}>
          <span class="btn__label">{% if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
          <span class="btn__icon">{% render 'icon', name: 'arrow-up-right' %}</span>
        </button>
      </div>
    {%- endform -%}
    {%- endif -%}

    {%- if product.description != blank or section.blocks.size > 0 -%}
      <div class="pdp__accordions">
        {%- if product.description != blank -%}
          {%- comment -%} Open by default on mobile; JS closes it on desktop
            (see initPdpDescriptionDefault in theme.js) — kept open here so
            it's correct with JS disabled and for the mobile default. {%- endcomment -%}
          <details class="accordion" open data-default-open="mobile">
            <summary>{{ section.settings.description_label }} {% render 'icon', name: 'plus' %}</summary>
            <div class="accordion__body rte">{{ product.description }}</div>
          </details>
        {%- endif -%}
        {%- for block in section.blocks -%}
          <details class="accordion" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.heading }} {% render 'icon', name: 'plus' %}</summary>
            <div class="accordion__body rte">
              {%- if block.settings.use_metafield and product.metafields.custom.specifications != blank -%}
                {{ product.metafields.custom.specifications | metafield_tag }}
              {%- else -%}
                {{ block.settings.content }}
              {%- endif -%}
            </div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}
    </div>
  </div>
</section>

{%- comment -%} "You might also like" now lives in its own section (product-recommendations). {%- endcomment -%}

{%- capture variant_json -%}
[
  {%- for v in product.variants -%}
    {"id": {{ v.id }}, "available": {{ v.available }}, "options": {{ v.options | json }}, "price": {{ v.price | money | strip_html | json }}}{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
]
{%- endcapture -%}
<script type="application/json" data-product-json
        data-add-text="{{ 'products.product.add_to_cart' | t | escape }}"
        data-soldout-text="{{ 'products.product.sold_out' | t | escape }}"
        data-unavailable-text="{{ 'products.product.unavailable' | t | escape }}">{{ variant_json }}</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "text", "id": "description_label", "label": "Description accordion label", "default": "Description" }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Details & Specifications" },
        { "type": "checkbox", "id": "use_metafield", "label": "Use each product's Specifications metafield", "info": "When on, this row shows the product's custom.specifications rich-text metafield (falls back to the content below if empty).", "default": false },
        { "type": "richtext", "id": "content", "label": "Content (or fallback)", "default": "<p>Water-repellent nylon shell. Padded 15\" laptop sleeve. Quick-access front pocket. Reinforced base.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product",
      "blocks": [
        { "type": "accordion", "settings": { "heading": "Details & Specifications" } },
        { "type": "accordion", "settings": { "heading": "Shipping, Returns & Warranty", "content": "<p>Free shipping over ₱2,500. 30-day returns. 2-year warranty against manufacturing defects.</p>" } }
      ]
    }
  ]
}
{% endschema %}
