<section class="notfound" data-section="404" data-section-theme="light">
  <div class="notfound__inner">
    <h1 class="notfound__title">{{ 'general.404.title' | t }}</h1>
    <p class="notfound__body">{{ 'general.404.body' | t }}</p>
    <a href="{{ routes.root_url }}" class="btn btn--dark"><span class="btn__label">{{ 'general.404.link' | t }}</span><span class="btn__icon">{% render 'icon', name: 'arrow-up-right' %}</span></a>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "settings": []
}
{% endschema %}
