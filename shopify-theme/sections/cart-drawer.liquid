{%- comment -%}
  Slide-in cart drawer. Rendered once in the layout so it persists on every page.
  After any cart mutation theme.js re-fetches this section via the Section
  Rendering API (/?sections=cart-drawer) and swaps the inner markup, so all money
  formatting and line-item logic stays in Liquid.
{%- endcomment -%}
{%- comment -%} routes.root_url keeps the section fetch correct under locale/market prefixes. {%- endcomment -%}
<div class="cart-drawer" data-cart-drawer hidden
     data-cart-section-url="{{ routes.root_url }}?sections=cart-drawer"
     data-cart-item-count="{{ cart.item_count }}">
  <div class="cart-drawer__scrim" data-cart-close></div>
  <aside class="cart-drawer__panel" role="dialog" aria-modal="true"
         aria-label="{{ 'cart.general.title' | t }}" data-cart-panel>
    <header class="cart-drawer__head">
      <h2 class="cart-drawer__title">
        {{ 'cart.general.title' | t }}
        <span class="cart-drawer__count">({{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %})</span>
      </h2>
      <button type="button" class="cart-drawer__close" data-cart-close aria-label="{{ 'cart.general.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </header>

    {%- if cart.item_count > 0 -%}
      <ul class="cart-drawer__items">
        {%- for item in cart.items -%}
          <li class="cart-drawer__item" data-line="{{ forloop.index }}">
            <a class="cart-drawer__item-media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 200 }}" alt="" width="96" height="96" loading="lazy">
              {%- endif -%}
            </a>
            <div class="cart-drawer__item-body">
              <div class="cart-drawer__item-top">
                <a class="cart-drawer__item-title" href="{{ item.url }}">{{ item.product.title }}</a>
                <p class="cart-drawer__item-price">
                  {%- if item.original_line_price > item.final_line_price -%}
                    <s>{{ item.original_line_price | money }}</s>
                  {%- endif -%}
                  {{ item.final_line_price | money }}
                </p>
              </div>
              {%- unless item.product.has_only_default_variant -%}
                <p class="cart-drawer__item-variant">
                  {%- for opt in item.options_with_values -%}
                    {{ opt.value }}{%- unless forloop.last %} <span aria-hidden="true">|</span> {% endunless -%}
                  {%- endfor -%}
                </p>
              {%- endunless -%}
              {%- if item.selling_plan_allocation -%}
                <p class="cart-drawer__item-variant">{{ item.selling_plan_allocation.selling_plan.name }}</p>
              {%- endif -%}
              <div class="cart-drawer__item-controls">
                <div class="cart-drawer__qty">
                  <button type="button" data-line-change="{{ item.quantity | minus: 1 }}"
                          aria-label="Decrease quantity">{% render 'icon', name: 'minus' %}</button>
                  <span class="cart-drawer__qty-value">{{ item.quantity }}</span>
                  <button type="button" data-line-change="{{ item.quantity | plus: 1 }}"
                          aria-label="Increase quantity">{% render 'icon', name: 'plus' %}</button>
                </div>
                <button type="button" class="cart-drawer__remove" data-line-change="0"
                        aria-label="{{ 'cart.general.remove' | t }} {{ item.product.title | escape }}">
                  {% render 'icon', name: 'trash' %}
                </button>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      <footer class="cart-drawer__foot">
        <div class="cart-drawer__total">
          <span>Total</span>
          <strong>{{ cart.total_price | money }}</strong>
        </div>
        <p class="cart-drawer__tax">Taxes calculated at checkout</p>
        <form action="{{ routes.cart_url }}" method="post">
          {%- comment -%} btn--light on the dark panel — btn--dark would disappear into it. {%- endcomment -%}
          <button type="submit" name="checkout" class="btn btn--light cart-drawer__checkout">
            <span class="btn__label">{{ 'cart.general.checkout' | t }}</span>
            <span class="btn__icon">{% render 'icon', name: 'arrow-up-right' %}</span>
          </button>
        </form>
      </footer>
    {%- else -%}
      <div class="cart-drawer__empty">
        <p>{{ 'cart.general.empty' | t }}</p>
        <a class="btn btn--light" href="{{ routes.all_products_collection_url }}">
          <span class="btn__label">{{ 'cart.general.continue_shopping' | t }}</span>
          <span class="btn__icon">{% render 'icon', name: 'arrow-up-right' %}</span>
        </a>
      </div>
    {%- endif -%}
  </aside>
</div>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
