{%- liquid
  assign coll = collections[section.settings.collection]
  assign limit = section.settings.limit
-%}
<section class="product-grid" id="{{ section.settings.anchor | default: 'new-arrivals' }}" data-section="product-grid" data-section-theme="light">
  <div class="product-grid__head">
    <h2 class="product-grid__heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.link_label != blank -%}
      <a class="product-grid__link" href="{{ section.settings.link_url | default: coll.url }}">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>
  <div class="product-grid__items">
    {%- if coll.products.size > 0 -%}
      {%- for product in coll.products limit: limit -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    {%- else -%}
      {%- comment -%} No collection yet — show placeholder cards so the layout reads. {%- endcomment -%}
      {%- for i in (1..limit) -%}
        <a class="product-card reveal" href="{{ routes.all_products_collection_url }}">
          <div class="product-card__image">{{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}</div>
          <div class="product-card__meta">
            <p class="product-card__title">Product title</p>
            <div class="product-card__info"><p class="product-card__price">{{ 2990 | money }}</p></div>
          </div>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "new-arrivals", "info": "Used by in-page links like #new-arrivals" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop now →" },
    { "type": "url", "id": "link_url", "label": "Link URL (defaults to the collection)" }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
