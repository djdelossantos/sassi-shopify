{%- comment -%} Lifestyle grid. Add blocks to customize, or leave empty for the default set. {%- endcomment -%}
<section class="lifestyle" data-section="lifestyle" data-section-theme="dark">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      {%- comment -%} Until a merchant uploads an image for a tile, fall back to the
        original bundled art so the grid looks unchanged. Whitelisted by title so we
        never point <img> at an asset that doesn't exist (a renamed tile just gets the
        generic placeholder instead of a broken image). {%- endcomment -%}
      {%- liquid
        assign bundled = 'work,tech,active,utility,travel,lifestyle' | split: ','
        assign key = block.settings.title | downcase | strip
        assign fallback_asset = ''
        if bundled contains key
          assign fallback_asset = 'life-' | append: key | append: '-2x.png'
        endif
      -%}
      <article class="lifestyle-tile reveal" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
        {%- elsif fallback_asset != blank -%}
          <img src="{{ fallback_asset | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'lifestyle-tile__placeholder' }}
        {%- endif -%}
        <span class="lifestyle-tile__scrim" aria-hidden="true"></span>
        <span class="noise" aria-hidden="true"></span>
        <div class="lifestyle-tile__text">
          <h3>{{ block.settings.title }}</h3>
          {%- comment -%} escape → newline_to_br: the design breaks this copy onto two
            lines. A merchant can't type <br> (inline_richtext/textarea settings reject
            raw tags), so they just press Enter and we convert it here — escaped first
            so nothing typed into the field can inject markup. {%- endcomment -%}
          <p>{{ block.settings.copy | escape | newline_to_br }}</p>
        </div>
      </article>
    {%- endfor -%}
  {%- else -%}
    {%- assign tiles = "Work|Streamlined style for the daily grind.<br>Keeps your work essentials perfectly arranged.|life-work-2x;;Tech|Secure padding for your mobile office.<br>Guards laptops and cables from bumps.|life-tech-2x;;Active|Lightweight resilience for life in motion.<br>Transitions easily from workouts to city streets.|life-active-2x;;Utility|Heavy-duty storage that works harder.<br>Reinforced details handle your toughest loads.|life-utility-2x;;Travel|Travel-ready design for smooth transit.<br>Includes intuitive layouts for hassle-free miles.|life-travel-2x;;Lifestyle|Effortless versatility for your daily routine.<br>Adapts to your changing schedule instantly.|life-lifestyle-2x" | split: ";;" -%}
    {%- for tile in tiles -%}
      {%- assign parts = tile | split: "|" -%}
      <article class="lifestyle-tile reveal">
        <img src="{{ parts[2] | append: '.png' | asset_url }}" alt="{{ parts[0] }}" loading="lazy">
        <span class="lifestyle-tile__scrim" aria-hidden="true"></span>
        <span class="noise" aria-hidden="true"></span>
        <div class="lifestyle-tile__text">
          <h3>{{ parts[0] }}</h3>
          <p>{{ parts[1] }}</p>
        </div>
      </article>
    {%- endfor -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Lifestyle grid",
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Work" },
        { "type": "textarea", "id": "copy", "label": "Copy", "info": "Press Enter for a line break.", "default": "Streamlined style for the daily grind.\nKeeps your work essentials perfectly arranged." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Lifestyle grid" }]
}
{% endschema %}
