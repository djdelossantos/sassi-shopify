{%- liquid
  if section.settings.bg != blank
    assign bg_src = section.settings.bg | image_url: width: 2400
  else
    assign bg_src = 'black-series-bg-2x.webp' | asset_url
  endif
  if section.settings.bag_1 != blank
    assign bag_1_src = section.settings.bag_1 | image_url: width: 1000
  else
    assign bag_1_src = 'black-series-athena-2x.png' | asset_url
  endif
  if section.settings.bag_2 != blank
    assign bag_2_src = section.settings.bag_2 | image_url: width: 1000
  else
    assign bag_2_src = 'black-series-artemis-2x.png' | asset_url
  endif
  if section.settings.bag_3 != blank
    assign bag_3_src = section.settings.bag_3 | image_url: width: 1000
  else
    assign bag_3_src = 'black-series-atlas-2x.png' | asset_url
  endif
  if section.settings.bag_4 != blank
    assign bag_4_src = section.settings.bag_4 | image_url: width: 1000
  else
    assign bag_4_src = 'black-series-apollo-2x.png' | asset_url
  endif
-%}
<section class="black-series" data-section="black-series" data-section-theme="light">
  <img class="black-series__bg" src="{{ bg_src }}" alt="" aria-hidden="true" loading="lazy">
  <div class="black-series__bags">
    <div class="black-series__bag-row">
      <img class="black-series__bag black-series__bag--athena" src="{{ bag_1_src }}" alt="SASSi Athena handbag" loading="lazy">
      <img class="black-series__bag black-series__bag--artemis" src="{{ bag_2_src }}" alt="SASSi Artemis tote" loading="lazy">
    </div>
    <div class="black-series__bag-row">
      <img class="black-series__bag black-series__bag--atlas" src="{{ bag_3_src }}" alt="SASSi Atlas backpack" loading="lazy">
      <img class="black-series__bag black-series__bag--apollo" src="{{ bag_4_src }}" alt="SASSi Apollo utility tote" loading="lazy">
    </div>
  </div>
  <div class="black-series__head">
    <h2 class="black-series__heading">{{ section.settings.heading }}</h2>
    <p class="black-series__sub">{{ section.settings.sub }}</p>
  </div>
  {%- if section.settings.button_label != blank -%}
    <div class="black-series__cta">
      {% render 'button', label: section.settings.button_label, style: 'dark', href: section.settings.button_link %}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Black Series",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Black Series" },
    { "type": "text", "id": "sub", "label": "Subheading", "default": "Blacked out. Built up." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Learn More" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "bg", "label": "Background image" },
    { "type": "header", "content": "Bags (left to right)" },
    { "type": "image_picker", "id": "bag_1", "label": "Bag 1" },
    { "type": "image_picker", "id": "bag_2", "label": "Bag 2" },
    { "type": "image_picker", "id": "bag_3", "label": "Bag 3" },
    { "type": "image_picker", "id": "bag_4", "label": "Bag 4" }
  ],
  "presets": [{ "name": "Black Series" }]
}
{% endschema %}
