{%- liquid
  if section.settings.bg != blank
    assign bg_src = section.settings.bg | image_url: width: 2400
  else
    assign bg_src = 'black-series-bg-2x.webp' | asset_url
  endif
  # Bags: a picked image wins, else the bundled photo. Every bag photo shares
  # one canvas height (2300px at 2x) with the bag drawn at its real size and
  # standing on the same baseline, so they line up at a single height. Width
  # and height go on the <img> so each keeps its own proportions; the old fixed
  # per-slot aspect ratios stretched any replacement photo.
  assign bag_1 = section.settings.bag_1
  assign bag_2 = section.settings.bag_2
  assign bag_3 = section.settings.bag_3
  assign bag_4 = section.settings.bag_4
-%}
<section class="black-series" data-section="black-series" data-section-theme="light">
  <img class="black-series__bg" src="{{ bg_src }}" alt="" aria-hidden="true" loading="lazy">
  <div class="black-series__bags">
    <div class="black-series__bag-row">
      {%- render 'black-series-bag', image: bag_1, fallback: 'black-series-athena-2x.webp', w: 1605, slot: 'athena', alt: 'SASSi Athena handbag' -%}
      {%- render 'black-series-bag', image: bag_2, fallback: 'black-series-artemis-2x.webp', w: 2133, slot: 'artemis', alt: 'SASSi Artemis tote' -%}
    </div>
    <div class="black-series__bag-row">
      {%- render 'black-series-bag', image: bag_3, fallback: 'black-series-aries-2x.webp', w: 1917, slot: 'aries', alt: 'SASSi Aries backpack' -%}
      {%- render 'black-series-bag', image: bag_4, fallback: 'black-series-apollo-2x.webp', w: 1963, slot: 'apollo', alt: 'SASSi Apollo tote' -%}
    </div>
  </div>
  <div class="black-series__head">
    <h2 class="black-series__heading">{{ section.settings.heading }}</h2>
    <p class="black-series__sub">{{ section.settings.sub }}</p>
  </div>
  {%- if section.settings.button_label != blank -%}
    <div class="black-series__cta">
      {% render 'button', label: section.settings.button_label, style: 'dark', href: section.settings.button_link %}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Black Series",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Black Series" },
    { "type": "text", "id": "sub", "label": "Subheading", "default": "Blacked out. Built up." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "bg", "label": "Background image" },
    { "type": "header", "content": "Bags (left to right)" },
    { "type": "paragraph", "content": "Bag photos line up at one height, so give every bag photo the same canvas height with the bag drawn at its real size and standing on the bottom edge (transparent PNG/WebP). Left empty, the bundled photos show." },
    { "type": "image_picker", "id": "bag_1", "label": "Bag 1 (Athena)" },
    { "type": "image_picker", "id": "bag_2", "label": "Bag 2 (Artemis)" },
    { "type": "image_picker", "id": "bag_3", "label": "Bag 3 (Aries)" },
    { "type": "image_picker", "id": "bag_4", "label": "Bag 4 (Apollo)" }
  ],
  "presets": [{ "name": "Black Series" }]
}
{% endschema %}
