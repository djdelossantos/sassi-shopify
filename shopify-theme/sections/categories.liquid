{%- comment -%} Category showcase. Add blocks to customize, or leave empty for the default set. {%- endcomment -%}
<section class="categories" data-section="categories" data-section-theme="light">
  <div class="categories__track">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- comment -%} Until a merchant uploads an image for a card, fall back to the
          original bundled art so the homepage looks unchanged. Whitelisted by title so
          we never point <img> at an asset that doesn't exist (a renamed card just gets
          the generic placeholder instead of a broken image). {%- endcomment -%}
        {%- liquid
          assign bundled = 'backpacks,totes,handbags' | split: ','
          assign key = block.settings.title | downcase | strip
          assign fallback_asset = ''
          if bundled contains key
            assign fallback_asset = 'cat-' | append: key | append: '-2x.png'
          endif
          # Where the card goes: Shop All opened on this product type's tab (the
          # same URL a Search & Discovery Product type filter uses), else the
          # chosen collection, else nowhere.
          assign card_url = ''
          if block.settings.product_type != blank
            assign type_param = block.settings.product_type | strip | url_param_escape
            assign card_url = routes.all_products_collection_url | append: '?filter.p.product_type=' | append: type_param
          elsif block.settings.link != blank
            assign card_url = block.settings.link.url
          endif
        -%}
        {%- comment -%} With a destination, the whole card links to it: the title's
          link stretches over the card (::after), so the optional button can stay a
          separate link rather than nesting <a> inside <a>. {%- endcomment -%}
        <article class="category-card{% if card_url != blank %} category-card--link{% endif %}" {{ block.shopify_attributes }}>
          <div class="category-card__image" data-section-theme="dark">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 920 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {%- elsif fallback_asset != blank -%}
              <img src="{{ fallback_asset | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'category-card__placeholder' }}
            {%- endif -%}
            <span class="noise" aria-hidden="true"></span>
          </div>
          <h3 class="category-card__title">
            {%- if card_url != blank -%}
              <a class="category-card__link" href="{{ card_url }}">{{ block.settings.title }}<span class="category-card__arrow">{% render 'icon', name: 'arrow-up-right' %}</span></a>
            {%- else -%}
              {{ block.settings.title }}
            {%- endif -%}
          </h3>
          <p class="category-card__copy">{{ block.settings.copy }}</p>
          {%- if section.settings.show_buttons and card_url != blank -%}
            {% render 'button', label: 'Learn More', style: 'outline', href: card_url %}
          {%- endif -%}
        </article>
      {%- endfor -%}
    {%- else -%}
      {%- assign cards = "Backpacks|Built for the daily grind. Protective and weather-ready.|cat-backpacks-2x;;Totes|Everyday utility, simplified. Spacious storage for your routine.|cat-totes-2x;;Handbags|Compact and organized. Quick-access pockets for daily essentials.|cat-handbags-2x" | split: ";;" -%}
      {%- for card in cards -%}
        {%- assign parts = card | split: "|" -%}
        <article class="category-card">
          <div class="category-card__image" data-section-theme="dark">
            <img src="{{ parts[2] | append: '.png' | asset_url }}" alt="{{ parts[0] }}" loading="lazy">
            <span class="noise" aria-hidden="true"></span>
          </div>
          <h3 class="category-card__title">{{ parts[0] }}</h3>
          <p class="category-card__copy">{{ parts[1] }}</p>
        </article>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Categories",
  "settings": [
    { "type": "checkbox", "id": "show_buttons", "label": "Show card buttons", "default": false }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Backpacks" },
        { "type": "textarea", "id": "copy", "label": "Copy", "default": "Built for the daily grind. Protective and weather-ready." },
        {
          "type": "text", "id": "product_type", "label": "Product type",
          "info": "Opens the Shop page on this type's tab. Must match the product type exactly, e.g. Backpack. Takes priority over the collection below."
        },
        { "type": "collection", "id": "link", "label": "Links to collection", "info": "Used when Product type is empty." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Categories" }]
}
{% endschema %}
