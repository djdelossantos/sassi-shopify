<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#12100e">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>{{ page_title }}{% if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {%- comment -%} Preload the two most-used font weights {%- endcomment -%}
  <link rel="preload" href="{{ 'open-sauce-two-latin-800-normal.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ 'open-sauce-two-latin-400-normal.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>

  {{ 'fonts.css' | asset_url | stylesheet_tag }}
  {{ 'tokens.css' | asset_url | stylesheet_tag }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}

  {%- comment -%} First-load preloader must paint dark on the very first frame. {%- endcomment -%}
  <style>.preloader{position:fixed;inset:0;z-index:10000;background:#12100e;display:flex;align-items:center;justify-content:center}</style>
  <noscript><style>.preloader{display:none!important}</style></noscript>

  {{ content_for_header }}
</head>

<body class="template-{{ request.page_type }}">
  <a class="visually-hidden" href="#main">{{ 'accessibility.skip_to_content' | t }}</a>

  <div class="preloader" data-preloader aria-hidden="true">
    <div class="preloader__inner">
      <span class="preloader__count" data-preloader-count>00</span>
      <div class="preloader__dots"><span></span><span></span><span></span></div>
    </div>
  </div>
  <div class="page-intro" data-page-intro aria-hidden="true">
    <div class="page-intro__logo">{% render 'logo' %}</div>
  </div>

  {% section 'header' %}

  <main id="main" role="main">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {% section 'cart-drawer' %}

  <script src="{{ 'lenis.min.js' | asset_url }}" defer></script>
  <script src="{{ 'gsap.min.js' | asset_url }}" defer></script>
  <script src="{{ 'ScrollTrigger.min.js' | asset_url }}" defer></script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
