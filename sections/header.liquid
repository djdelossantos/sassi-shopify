<header class="sassi-header" data-sassi-header>
  <nav class="sassi-header__nav">
    <a href="{{ section.settings.nav_link_1_url | default: '#shop' }}">{{ section.settings.nav_link_1_label | default: 'Shop' }}</a>
    <a href="{{ section.settings.nav_link_2_url | default: '#story' }}">{{ section.settings.nav_link_2_label | default: 'The Brand' }}</a>
  </nav>

  <a href="{{ routes.root_url }}" class="sassi-header__logo" title="{{ shop.name }}" style="--sassi-logo-mask: url('{{ 'sassi-logo.svg' | asset_url }}');"></a>

  <div class="sassi-header__icons">
    <a href="{{ routes.search_url }}" title="{{ 'general.search' | t }}" class="sassi-header__icon">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    </a>
    <a href="{{ routes.account_url }}" title="{{ 'general.account' | t }}" class="sassi-header__icon">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
    </a>
    <a href="{{ routes.cart_url }}" title="{{ 'general.cart' | t }}" class="sassi-header__icon sassi-header__icon--cart">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
      {%- if cart.item_count > 0 -%}
        <span class="sassi-header__cart-count">{{ cart.item_count }}</span>
      {%- endif -%}
    </a>
  </div>
</header>

{% stylesheet %}
.sassi-header {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 24px;
  padding: 18px 24px;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: none;
  z-index: 80;
  color: var(--color-white);
  transition: color 0.35s ease;
}
.sassi-header.is-on-light { color: var(--color-obsidian); }

.sassi-header__nav {
  display: flex;
  gap: 24px;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.02em;
}
.sassi-header__nav a { color: inherit; text-decoration: none; }
.sassi-header__nav a:hover { color: var(--color-red); }

.sassi-header__logo {
  width: 84px;
  height: 35px;
  background-color: currentColor;
  -webkit-mask: var(--sassi-logo-mask) no-repeat center / contain;
  mask: var(--sassi-logo-mask) no-repeat center / contain;
  display: block;
}

.sassi-header__icons {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 20px;
}
.sassi-header__icon {
  position: relative;
  display: flex;
  color: inherit;
}
.sassi-header__icon:hover { color: var(--color-red); }
.sassi-header__cart-count {
  position: absolute;
  top: -6px;
  right: -8px;
  background: var(--color-red);
  color: var(--color-white);
  font-size: 10px;
  font-weight: 700;
  line-height: 1;
  padding: 2px 5px;
  border-radius: 20px;
}

@media (max-width: 640px) {
  .sassi-header { padding: 14px 16px; gap: 12px; }
  .sassi-header__nav { gap: 14px; font-size: 12px; }
  .sassi-header__icons { gap: 14px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "nav_link_1_label", "label": "Nav link 1 label", "default": "Shop" },
    { "type": "url", "id": "nav_link_1_url", "label": "Nav link 1 URL" },
    { "type": "text", "id": "nav_link_2_label", "label": "Nav link 2 label", "default": "The Brand" },
    { "type": "url", "id": "nav_link_2_url", "label": "Nav link 2 URL" }
  ]
}
{% endschema %}
