<section class="sassi-new-arrivals" data-screen-label="New arrivals">
  <div class="sassi-new-arrivals__heading" data-reveal>
    <h2>{{ section.settings.heading | default: 'New Arrivals' }}</h2>
    {%- if section.settings.link_label != blank -%}
      <a href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>

  <div class="sassi-new-arrivals__grid">
    {%- if section.settings.collection != blank -%}
      {%- for p in section.settings.collection.products limit: section.settings.product_limit -%}
        <a data-reveal href="{{ p.url }}" class="sassi-new-arrivals__card">
          <div class="sassi-image-slot">
            {%- if p.featured_image != blank -%}
              {{ p.featured_image | image_url: width: 800 | image_tag: widths: '400,600,800', sizes: '(min-width: 900px) 22vw, 45vw' }}
            {%- else -%}
              <div class="sassi-image-slot__label">{{ p.title }}</div>
            {%- endif -%}
          </div>
          <div class="sassi-new-arrivals__meta">
            <div class="sassi-new-arrivals__name">{{ p.title }}</div>
            <div class="sassi-new-arrivals__price">{{ p.price | money }}</div>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for block in section.blocks -%}
        <a data-reveal href="#" class="sassi-new-arrivals__card" {{ block.shopify_attributes }}>
          <div class="sassi-image-slot">
            <div class="sassi-image-slot__label">{{ block.settings.placeholder_label }}</div>
          </div>
          <div class="sassi-new-arrivals__meta">
            <div class="sassi-new-arrivals__name">{{ block.settings.placeholder_label }}</div>
            <div class="sassi-new-arrivals__price">{{ block.settings.placeholder_price }}</div>
          </div>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.sassi-new-arrivals {
  padding: 72px 16px 24px 16px;
}

.sassi-new-arrivals__heading {
  text-align: center;
  padding-bottom: 36px;
}
.sassi-new-arrivals__heading h2 {
  margin: 0;
  font-weight: 700;
  font-size: 20px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.sassi-new-arrivals__heading a {
  display: inline-block;
  margin-top: 8px;
  font-size: 13px;
  font-weight: 600;
  color: var(--color-obsidian);
}
.sassi-new-arrivals__heading a:hover { color: var(--color-red); }

.sassi-new-arrivals__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}

.sassi-new-arrivals__card {
  text-decoration: none;
  color: inherit;
  display: block;
}
.sassi-new-arrivals__card .sassi-image-slot {
  position: relative;
  width: 100%;
  aspect-ratio: 5 / 6;
}
.sassi-new-arrivals__meta { padding: 14px 0 0; }
.sassi-new-arrivals__name { font-weight: 600; font-size: 13px; color: var(--color-obsidian); }
.sassi-new-arrivals__price { font-size: 12px; color: var(--color-body); margin-top: 2px; }

@media (max-width: 900px) {
  .sassi-new-arrivals__grid { grid-template-columns: repeat(2, 1fr); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "New arrivals",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop now →" },
    { "type": "url", "id": "link_url", "label": "Link URL" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "If set, pulls products from this collection instead of the manual cards below" },
    { "type": "range", "id": "product_limit", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "product_placeholder",
      "name": "Manual product card",
      "settings": [
        { "type": "text", "id": "placeholder_label", "label": "Name", "default": "Product name" },
        { "type": "text", "id": "placeholder_price", "label": "Price", "default": "₱0" }
      ]
    }
  ],
  "presets": [
    {
      "name": "New arrivals",
      "blocks": [
        { "type": "product_placeholder" },
        { "type": "product_placeholder" },
        { "type": "product_placeholder" },
        { "type": "product_placeholder" }
      ]
    }
  ]
}
{% endschema %}
