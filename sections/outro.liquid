<section class="sassi-outro" data-screen-label="Outro">
  <h2 class="sassi-outro__headline" data-reveal>
    {{ section.settings.heading }}<br>
    {{ section.settings.heading_line2 }} <span class="sassi-outro__accent">{{ section.settings.heading_accent }}</span>
  </h2>
  <div class="sassi-outro__mark">{{ section.settings.mark }}</div>
</section>

{% stylesheet %}
.sassi-outro {
  padding: 64px 24px 72px 24px;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 32px;
  flex-wrap: wrap;
}

.sassi-outro__headline {
  margin: 0;
  font-weight: 800;
  font-size: clamp(38px, 4.8vw, 72px);
  line-height: 1.02;
  letter-spacing: -0.03em;
  max-width: 760px;
}
.sassi-outro__accent { color: var(--color-red); }

.sassi-outro__mark {
  font-weight: 800;
  font-size: clamp(38px, 4.8vw, 72px);
  letter-spacing: -0.03em;
  color: var(--color-obsidian);
}
{% endstylesheet %}

{% schema %}
{
  "name": "Outro statement",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (line 1)", "default": "Designed for You" },
    { "type": "text", "id": "heading_line2", "label": "Heading (line 2)", "default": "to" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (red)", "default": "Carry On." },
    { "type": "text", "id": "mark", "label": "Corner mark", "default": "©26" }
  ],
  "presets": [
    { "name": "Outro statement" }
  ]
}
{% endschema %}
