<section class="sassi-hero" data-dark data-screen-label="Hero">
  <div class="sassi-hero__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'sassi-hero__video' }}
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2000 | image_tag: class: 'sassi-hero__image', loading: 'eager', widths: '750,1100,1500,2000' }}
    {%- else -%}
      <div class="sassi-video-placeholder">
        <div class="sassi-video-placeholder__box">
          <strong>LOOPING VIDEO — FULLSCREEN HERO</strong>
          <div>muted · autoplay · no controls · candid street footage</div>
        </div>
      </div>
    {%- endif -%}
  </div>

  <div class="sassi-hero__overlay"></div>

  <div class="sassi-hero__content">
    <h1 class="sassi-hero__headline" data-intro>{{ section.settings.headline | default: 'Carry On.' | split: '.' | first }}<span class="sassi-hero__accent">.</span></h1>
    {%- if section.settings.cta_label != blank -%}
      <a data-intro href="{{ section.settings.cta_url | default: '#shop' }}" class="sassi-hero__cta">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.sassi-hero {
  position: relative;
  height: 100vh;
  min-height: 580px;
  width: 100%;
  overflow: hidden;
}

.sassi-hero__media,
.sassi-hero__video,
.sassi-hero__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.sassi-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(18,16,14,0.6) 0%, rgba(18,16,14,0.08) 45%, rgba(18,16,14,0.25) 100%);
  pointer-events: none;
}

.sassi-hero__content {
  position: absolute;
  left: 24px;
  right: 24px;
  bottom: 36px;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 28px;
  flex-wrap: wrap;
  color: var(--color-white);
}

.sassi-hero__headline {
  margin: 0;
  font-weight: 800;
  font-size: clamp(56px, 9.5vw, 150px);
  line-height: 0.88;
  letter-spacing: -0.03em;
}
.sassi-hero__accent { color: var(--color-red); }

.sassi-hero__cta {
  text-decoration: underline;
  text-underline-offset: 5px;
  font-size: 15px;
  font-weight: 600;
  color: var(--color-white);
  white-space: nowrap;
}
.sassi-hero__cta:hover { color: var(--color-red); }
{% endstylesheet %}

{% schema %}
{
  "name": "Video hero",
  "settings": [
    { "type": "video", "id": "video", "label": "Background video" },
    { "type": "image_picker", "id": "image", "label": "Fallback background image", "info": "Used if no video is set" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Carry On." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop the drop →" },
    { "type": "url", "id": "cta_url", "label": "CTA link" }
  ],
  "presets": [
    { "name": "Video hero" }
  ]
}
{% endschema %}
