<section{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id }}"{% endif %} class="sassi-product-row" data-screen-label="{{ section.settings.row_label }}">
  {%- for block in section.blocks -%}
    {%- case block.type -%}

      {%- when 'product' -%}
        {%- assign p = block.settings.product -%}
        <a data-reveal href="{% if p != blank %}{{ p.url }}{% else %}#{% endif %}" class="sassi-product-row__card" {{ block.shopify_attributes }}>
          <div class="sassi-product-row__image">
            <div class="sassi-image-slot">
              {%- if p != blank and p.featured_image != blank -%}
                {{ p.featured_image | image_url: width: 800 | image_tag: widths: '400,600,800', sizes: '(min-width: 900px) 25vw, 45vw' }}
              {%- else -%}
                <div class="sassi-image-slot__label">{{ block.settings.placeholder_label | default: 'Product' }}</div>
              {%- endif -%}
            </div>
            <div class="sassi-product-row__meta">
              <div class="sassi-product-row__name">{{ p.title | default: block.settings.placeholder_label }}</div>
              <div class="sassi-product-row__price">
                {%- if p != blank -%}{{ p.price | money }}{%- else -%}{{ block.settings.placeholder_price }}{%- endif -%}
              </div>
            </div>
          </div>
        </a>

      {%- when 'category' -%}
        <div data-reveal class="sassi-product-row__category" {{ block.shopify_attributes }}>
          <div class="sassi-image-slot">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: widths: '600,900,1200', sizes: '(min-width: 900px) 50vw, 90vw' }}
            {%- else -%}
              <div class="sassi-image-slot__label">{{ block.settings.title }} — {{ block.settings.placeholder_note }}</div>
            {%- endif -%}
          </div>
          <div class="sassi-product-row__category-overlay">
            <div class="sassi-product-row__category-copy">
              <div class="sassi-product-row__category-title">{{ block.settings.title }}</div>
              <p class="sassi-product-row__category-desc">{{ block.settings.description }}</p>
            </div>
            <a href="{{ block.settings.button_url }}" class="sassi-pill">{{ block.settings.button_label }}</a>
          </div>
        </div>

    {%- endcase -%}
  {%- endfor -%}
</section>

{% stylesheet %}
.sassi-product-row {
  padding: 0 16px;
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: 16px;
  align-items: start;
}

.sassi-product-row__card {
  grid-column: span 3;
  text-decoration: none;
  color: inherit;
  display: block;
}
.sassi-product-row__image {
  position: relative;
  width: 100%;
  aspect-ratio: 5 / 6;
}
.sassi-product-row__meta {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 14px;
  pointer-events: none;
}
.sassi-product-row__name {
  font-weight: 600;
  font-size: 13px;
  color: var(--color-obsidian);
}
.sassi-product-row__price {
  font-size: 12px;
  color: var(--color-body);
  margin-top: 2px;
}

.sassi-product-row__category {
  grid-column: span 6;
  position: relative;
  aspect-ratio: 1 / 1.15;
  overflow: hidden;
}
.sassi-product-row__category-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 22px 20px;
  background: linear-gradient(to top, rgba(18,16,14,0.72), rgba(18,16,14,0) 90%);
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 16px;
}
.sassi-product-row__category-copy { max-width: 62%; pointer-events: none; }
.sassi-product-row__category-title {
  font-weight: 700;
  font-size: 19px;
  letter-spacing: 0.04em;
  color: var(--color-white);
  text-transform: uppercase;
}
.sassi-product-row__category-desc {
  margin: 6px 0 0 0;
  font-size: 12.5px;
  line-height: 1.55;
  color: rgba(255,255,255,0.9);
}

@media (max-width: 700px) {
  .sassi-product-row__card { grid-column: span 6; }
  .sassi-product-row__category { grid-column: span 12; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Product row",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "info": "e.g. shop — used for nav links to jump here" },
    { "type": "text", "id": "row_label", "label": "Internal label", "default": "Product row" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product card",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "placeholder_label", "label": "Placeholder name", "default": "Product name" },
        { "type": "text", "id": "placeholder_price", "label": "Placeholder price", "default": "₱0" }
      ]
    },
    {
      "type": "category",
      "name": "Category card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "placeholder_note", "label": "Placeholder note", "default": "category image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Category" },
        { "type": "text", "id": "description", "label": "Description" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "button_url", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product row",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
