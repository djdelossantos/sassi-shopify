<section id="story" class="sassi-manifesto" data-screen-label="Manifesto">
  <div class="sassi-manifesto__media" data-reveal>
    <div class="sassi-image-slot">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: widths: '400,600,900,1200', sizes: '(min-width: 900px) 40vw, 90vw' }}
      {%- else -%}
        <div class="sassi-image-slot__label">Candid photo — person with bag</div>
      {%- endif -%}
    </div>
  </div>

  <div class="sassi-manifesto__copy" data-reveal>
    <h2 class="sassi-manifesto__heading">
      {{ section.settings.heading }}<br class="manifesto-break">
      <span class="sassi-manifesto__accent">{{ section.settings.heading_accent }}</span>
    </h2>
    <div class="sassi-manifesto__body">{{ section.settings.body }}</div>
  </div>
</section>

{% stylesheet %}
.sassi-manifesto {
  padding: 16px;
  display: grid;
  grid-template-columns: 5fr 7fr;
  gap: 48px;
  align-items: center;
}

.sassi-manifesto__media {
  position: relative;
  aspect-ratio: 4 / 5;
}

.sassi-manifesto__copy {
  display: flex;
  flex-direction: column;
  gap: 20px;
  padding-right: 8%;
}

.sassi-manifesto__heading {
  margin: 0;
  font-weight: 800;
  font-size: clamp(34px, 5.6vw, 76px);
  line-height: 1.08;
  letter-spacing: -0.02em;
}
.sassi-manifesto__accent { color: var(--color-red); }

.sassi-manifesto__body {
  margin: 0;
  max-width: 420px;
  font-size: 14px;
  line-height: 1.7;
  color: var(--color-body);
}
.sassi-manifesto__body p { margin: 0; }

@media (max-width: 780px) {
  .sassi-manifesto {
    grid-template-columns: 1fr;
    gap: 24px;
  }
  .sassi-manifesto__copy { padding-right: 0; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Manifesto",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading (line 1)", "default": "A reliable product for the people " },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (red)", "default": "we rely on." },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body copy",
      "default": "<p>Bags for the shift, the commute, and everything you haul in between. No fuss, no flex — gear that shows up every day, the way you do.</p>"
    }
  ],
  "presets": [
    { "name": "Manifesto" }
  ]
}
{% endschema %}
